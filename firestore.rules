rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin login checks only the signed-in user's own admin marker.
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Allow read for FCM/system secrets only if authenticated as an Admin. Writes blocked from clients.
    match /admin_secrets/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 1. Standard rules for user folders
    match /users/{userId}/{document=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. NEW: Explicit rules required for Collection Group Queries
    match /{path=**}/expenses/{expenseId} {
      allow read: if isAdmin();
    }
    match /{path=**}/ocr_logs/{logId} {
      allow read: if isAdmin();
    }
    
    // 3. Global Dictionary
    match /ocr_learning/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
        // Allow anyone to read broadcasts, but ONLY Admins can push them
    match /system_config/{document=**} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

  }
}
